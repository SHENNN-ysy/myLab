// ============================================================
// MyBlog CI 流水线（每次 push 自动触发）
//
// Jenkins 侧一次性配置：
//   1. 新建 Multibranch Pipeline，Branch Source 选 GitHub/Git，
//      开启 "Discover Branches"（所有分支），Script Path 填 Jenkinsfile.ci
//   2. GitHub webhook 指向 Nginx HTTPS 入口：
//      https://<BLOG_DOMAIN><JENKINS_ROUTE>/github-webhook/
//
// 节点前置条件：
//   - 安装 Docker，且 jenkins 用户已加入 docker 组
//   - 后端集成测试基于 Testcontainers，需要访问 /var/run/docker.sock
//   - 安装 JUnit 插件与 Coverage 插件（覆盖率报告；JaCoCo 独立插件已 EOL）
// ============================================================
pipeline {
    agent none

    options {
        timestamps()
        disableConcurrentBuilds()
        buildDiscarder(logRotator(numToKeepStr: '20'))
    }

    stages {
        stage('Backend CI') {
            agent {
                docker {
                    // 挂载 docker.sock 供 Testcontainers 起 PG/Redis。
                    // 容器内进程 uid=1000（镜像内 ubuntu 用户，HOME=/home/ubuntu）：
                    //   --group-add 988 补宿主机 docker 组权限（访问挂载的 sock；
                    //     GID 以宿主机 getent group docker 为准，迁移机器时需同步修改）
                    //   .m2 挂到 /home/ubuntu/.m2 才是该用户真实使用的 Maven 缓存路径，
                    //     避免每次构建全量下载依赖
                    image 'maven:3.9-eclipse-temurin-21'
                    args '-v /var/run/docker.sock:/var/run/docker.sock -v /data/jenkins/.m2:/home/ubuntu/.m2 --group-add 988'
                    reuseNode true
                }
            }
            steps {
                dir('backend-java') {
                    // verify = Checkstyle + 单元测试 + *IT 集成测试 + SpotBugs + JaCoCo
                    sh 'mvn -B verify'
                }
            }
            post {
                always {
                    junit allowEmptyResults: true,
                          testResults: 'backend-java/target/surefire-reports/*.xml, backend-java/target/failsafe-reports/*.xml'
                    // 覆盖率走 Coverage 插件（JaCoCo 独立插件已 EOL，功能并入其中），
                    // 解析 verify 阶段生成的 XML 报告
                    recordCoverage enabledForFailure: true,
                                   tools: [[parser: 'JACOCO',
                                            pattern: 'backend-java/target/site/jacoco/jacoco.xml']]
                }
            }
        }

        stage('Frontend CI') {
            parallel {
                stage('blog (myblog/)') {
                    agent {
                        docker {
                            image 'node:20-alpine'
                            reuseNode true
                        }
                    }
                    steps {
                        dir('myblog') {
                            sh 'npm ci --no-audit --no-fund'
                            sh 'npm run lint'
                            // build 内含 vue-tsc 类型检查，即编译验证
                            sh 'npm run build'
                        }
                    }
                }
                stage('admin (admin/)') {
                    agent {
                        docker {
                            image 'node:20-alpine'
                            reuseNode true
                        }
                    }
                    steps {
                        dir('admin') {
                            sh 'npm ci --no-audit --no-fund'
                            sh 'npm run lint'
                            sh 'npm run build'
                        }
                    }
                }
            }
        }
    }

    post {
        success {
            echo 'CI 通过：编译、静态检查与全部测试均成功。'
        }
        failure {
            echo 'CI 失败：请根据上方日志修复后重新推送。'
        }
    }
}
