# Application
APP_NAME=MyBlog
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=myblog
DB_PASSWORD=myblog_secret
DB_NAME=myblog
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# RabbitMQ
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=myblog
RABBITMQ_PASSWORD=myblog_secret
RABBITMQ_VHOST=/
RABBITMQ_PREFETCH=10

# JWT
JWT_SECRET=change-this-in-production-please
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRE_MINUTES=30
JWT_REFRESH_EXPIRE_DAYS=14

# MinIO
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=myblog
MINIO_SECURE=false
MINIO_PRESIGNED_EXPIRE=3600
MINIO_MAX_FILE_SIZE_MB=10

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Rate Limit
RATE_LIMIT_PER_MINUTE=60
LOGIN_RATE_LIMIT_PER_MINUTE=5

# Initial Admin
INIT_ADMIN_USERNAME=admin
INIT_ADMIN_PASSWORD=Admin@123456
INIT_ADMIN_EMAIL=admin@myblog.local