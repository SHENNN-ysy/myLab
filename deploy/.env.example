# 生产环境配置：复制为 deploy/.env，必须替换密码、密钥、域名和 OSS 凭据。

TZ=Asia/Shanghai
BLOG_DOMAIN=example.com
ADMIN_ROUTE=/admin
JENKINS_ROUTE=/jenkins
CORS_ORIGINS=https://example.com,https://www.example.com

# 本机镜像仓库
REGISTRY_HOST=127.0.0.1:5000
REGISTRY_API_HOST=registry:5000
REGISTRY_DATA_DIR=/data/registry
REGISTRY_KEEP_TAGS=5
REGISTRY_CLEANUP_DRY_RUN=true
DEPLOY_STATE_FILE=/data/jenkins/deploy-state/myblog-current-release
JENKINS_DATA_DIR=/data/jenkins
DEPLOY_CONFIG_DIR=/opt/myblog/deploy
APP_LOG_DIR=/data/myblog/logs
TLS_CERT_DIR=/opt/myblog/deploy/nginx/certs
TLS_CERT_FILE=fullchain.pem
TLS_KEY_FILE=privkey.pem
DOCKER_GID=998
DOCKER_APT_MIRROR=https://mirrors.ustc.edu.cn/docker-ce/linux/debian

# PostgreSQL
POSTGRES_USER=myblog
POSTGRES_PASSWORD=change-this-postgres-password
POSTGRES_DB=myblog

# Redis
REDIS_PASSWORD=change-this-redis-password

# OSS / CDN
OSS_ENDPOINT=https://oss-cn-hangzhou-internal.aliyuncs.com
OSS_ACCESS_KEY_ID=replace-with-ram-access-key-id
OSS_ACCESS_KEY_SECRET=replace-with-ram-access-key-secret
OSS_BUCKET=myblog-production
OSS_CDN_DOMAIN=
OSS_OBJECT_PREFIX=
OSS_MAX_FILE_SIZE_MB=10

# 阿里云 ARMS 应用监控（可选，留空不启用）。
# 探针文件需自行上传到宿主机 /opt/myblog/deploy/AliyunJavaAgent/（挂载到容器 /opt/arms，60MB 二进制不入库）；
# licenseKey 从 ARMS 控制台「Java 应用监控 → 手动安装」向导获取，appName 为 ARMS 上的应用名。
# 示例：ARMS_AGENT_OPTS=-javaagent:/opt/arms/aliyun-java-agent.jar -Darms.licenseKey=xxxx@xxxx -Darms.appName=myblog-backend
ARMS_AGENT_OPTS=
# 探针目录宿主机路径（默认 /opt/myblog/deploy/AliyunJavaAgent，一般无需修改）
ARMS_AGENT_DIR=

# 安全
JWT_SECRET=change-this-jwt-secret
ENGAGEMENT_HASH_SECRET=change-this-engagement-hash-secret

# 初始管理员
INIT_ADMIN_USERNAME=admin
INIT_ADMIN_PASSWORD=replace-with-strong-admin-password
INIT_ADMIN_EMAIL=admin@example.com
