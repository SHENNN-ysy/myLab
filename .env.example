# ============================================
# MyBlog Docker Compose 通用配置
# 复制本文件为 .env 并按需修改：
#   cp .env.example .env
#
# ⚠️ .env 文件已在 .gitignore 中，不会被提交
# ============================================

# ---- 时区 ----
TZ=Asia/Shanghai

# ---- PostgreSQL ----
POSTGRES_USER=myblog
POSTGRES_PASSWORD=myblog_secret
POSTGRES_DB=myblog
# ---- Redis（生产环境必须设置强密码）----
REDIS_PASSWORD=change-this-redis-password

# ---- 阿里云 OSS / CDN ----
# ECS 与 OSS 同地域时优先填写内网 Endpoint，例如：
# https://oss-cn-hangzhou-internal.aliyuncs.com
OSS_ENDPOINT=https://oss-cn-hangzhou-internal.aliyuncs.com
OSS_ACCESS_KEY_ID=replace-with-ram-access-key-id
OSS_ACCESS_KEY_SECRET=replace-with-ram-access-key-secret
OSS_BUCKET=myblog-production
# 暂不启用 CDN 时留空；配置域名后会自动切换为 CDN 公网地址。
OSS_CDN_DOMAIN=
# 留空表示直接使用 bucket 根目录下的 footstep/hero/hobbies/icon/mylab/mylab-post。
OSS_OBJECT_PREFIX=
OSS_MAX_FILE_SIZE_MB=10

# ---- 后端通用 ----
# ⚠️ JWT_SECRET 生产环境必须使用强随机值
#   生成方式: openssl rand -hex 32
JWT_SECRET=change-this-in-production-please
# 可选：用于把匿名 Cookie 令牌转换为 Redis visitorHash；未设置时沿用 JWT_SECRET
ENGAGEMENT_HASH_SECRET=change-this-engagement-hash-secret
# HTTPS 生产环境保持 true；仅本地纯 HTTP 调试时改为 false
VISITOR_COOKIE_SECURE=true

# 跨域来源（用英文逗号分隔，浏览器访问的源）
CORS_ORIGINS=https://example.com,https://admin.example.com

# ---- 域名 ----
BLOG_DOMAIN=example.com
ADMIN_DOMAIN=admin.example.com

# ---- 初始管理员 ----
INIT_ADMIN_USERNAME=admin
INIT_ADMIN_PASSWORD=replace-with-strong-admin-password
INIT_ADMIN_EMAIL=admin@example.com
