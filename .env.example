# ============================================
# MyBlog Docker Compose 通用配置
# 复制本文件为 .env 并按需修改：
#   cp .env.example .env
#
# ⚠️ .env 文件已在 .gitignore 中，不会被提交
# ============================================

# ---- 时区 ----
TZ=Asia/Shanghai

# ---- PostgreSQL ----
POSTGRES_USER=myblog
POSTGRES_PASSWORD=myblog_secret
POSTGRES_DB=myblog
POSTGRES_PORT=5432

# ---- Redis ----
# 如果不设置密码，redis 服务以无密码模式启动（仅限本地开发）
REDIS_PASSWORD=
REDIS_PORT=6379

# ---- RabbitMQ ----
RABBITMQ_USER=myblog
RABBITMQ_PASSWORD=myblog_secret
RABBITMQ_VHOST=/
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672

# ---- MinIO ----
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=myblog
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# ---- 后端通用 ----
# ⚠️ JWT_SECRET 生产环境必须使用强随机值
#   生成方式: openssl rand -hex 32
JWT_SECRET=change-this-in-production-please
APP_ENV=production
APP_DEBUG=false

# 跨域来源（用英文逗号分隔，浏览器访问的源）
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# ---- 后端 API 端口 ----
API_PORT=8000

# ---- 前端通过 Nginx 反向代理时的后端地址（可选）----
# 如果启用反代，可将以下变量传给 web 容器：
#   VITE_API_BASE_URL=/api

# ---- 后端：消息队列开关 ----
# true  = API 进程内自带 consumer（B 形态，单 API 容器）
# false = 由外部 worker 容器消费（C 形态）
MQ_INPROCESS_CONSUMER=true

# ---- 后端：管理员通知收件人 ----
# 收安全邮件（登录失败、改密等）。逗号分隔；留空禁用安全邮件。
ADMIN_NOTIFY_EMAILS=
